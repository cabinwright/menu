<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.cabinwright.menu"
    android:versionCode="8"
    android:versionName="1.6">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
    <!-- keeps a copy of the layout on the sdcard, since package updates wipe app data -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- The head unit's ActivityManager calls getTasks() when an app finishes its last activity (Back):
         without this the app crashes on the way out -->
    <uses-permission android:name="android.permission.GET_TASKS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/menu_icon"
        android:allowBackup="false">
        <activity
            android:name=".MenuActivity"
            android:theme="@style/CarTheme"
            android:screenOrientation="landscape"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- shows this app in All Menus (Cabinwright launcher hook) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="dev.cabinwright.category.ALL_MENUS" />
            </intent-filter>
            <meta-data android:name="dev.cabinwright.icon" android:resource="@drawable/menu_icon" />
            <meta-data android:name="dev.cabinwright.icon_disabled" android:resource="@drawable/menu_icon_dis" />
        </activity>

        <!-- the launcher hook reads the layout here, and reports its entries (system uid only) -->
        <provider
            android:name=".MenuProvider"
            android:authorities="dev.cabinwright.menu"
            android:exported="true" />
    </application>
</manifest>
